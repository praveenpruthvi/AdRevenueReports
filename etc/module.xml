<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Aavirbhava_AdsAnalytics" setup_version="1.0.0">
        <!--
            Load order only — magento/framework-message-queue is NOT listed
            here despite being a hard dependency: it registers as a LIBRARY,
            not a MODULE, so it has no place in <sequence>. It is declared in
            composer.json instead.
        -->
        <sequence>
            <module name="Magento_Store"/>
            <module name="Magento_Config"/>
            <module name="Magento_Backend"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Checkout"/>
            <module name="Magento_Reports"/>
            <module name="Magento_Webapi"/>
            <module name="Magento_Ui"/>
            <module name="Magento_Cron"/>
            <module name="Magento_MessageQueue"/>
            <module name="Magento_Amqp"/>
        </sequence>
    </module>
</config>
