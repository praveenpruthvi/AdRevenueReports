<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Extensibility point (docs/SPECS.md §5, P4-T3/P4-T4).
        A client project adds a new ad-spend provider (e.g. Reddit, Pinterest)
        by adding an <item> here in ITS OWN di.xml — never edit this array
        in this module's core to add a platform.

        google and meta are registered against the SAME class,
        Model\AdSpendProvider\CsvAdSpendProvider, which is the point:
        platform_code arrives as a getSpend() argument, not a constructor
        one, so one generic, credential-free implementation serves every
        platform that has not been given a real API-backed provider. A
        deployment with real Google Ads / Meta Ads API access replaces either
        line with its own provider class in ITS OWN di.xml (P4-T6 covers
        storing that provider's credentials); until then, both platforms read
        var/aavirbhava/adsanalytics/adspend/<platform_code>.csv, and simply
        have no data if that file does not exist.
    -->
    <type name="Aavirbhava\AdsAnalytics\Model\AdSpendProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="google" xsi:type="object">Aavirbhava\AdsAnalytics\Model\AdSpendProvider\CsvAdSpendProvider</item>
                <item name="meta" xsi:type="object">Aavirbhava\AdsAnalytics\Model\AdSpendProvider\CsvAdSpendProvider</item>
            </argument>
        </arguments>
    </type>

    <!--
        Grid data source for the Request Log listing (P3-T5b). Registering the
        collection under the listing's data source name is what lets the
        UI Component resolve it; without this entry the grid renders with no
        rows and no error, which looks exactly like "the table is empty".
    -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="aavirbhava_adsanalytics_request_log_listing_data_source" xsi:type="string">Aavirbhava\AdsAnalytics\Model\ResourceModel\RequestLog\Grid\Collection</item>
                <item name="aavirbhava_adsanalytics_summary_listing_data_source" xsi:type="string">Aavirbhava\AdsAnalytics\Model\ResourceModel\DailySummary\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!-- P3-T2: on-demand rollup, so the reports can be populated and
         backfilled without waiting for the nightly cron. -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="aavirbhava_adsanalytics_aggregate" xsi:type="object">Aavirbhava\AdsAnalytics\Console\Command\AggregateSummaryCommand</item>
                <item name="aavirbhava_adsanalytics_purge" xsi:type="object">Aavirbhava\AdsAnalytics\Console\Command\PurgeDataCommand</item>
            </argument>
        </arguments>
    </type>

    <preference for="Aavirbhava\AdsAnalytics\Api\EventIngestInterface"
                type="Aavirbhava\AdsAnalytics\Model\EventIngestService"/>
    <preference for="Aavirbhava\AdsAnalytics\Api\Data\EventInterface"
                type="Aavirbhava\AdsAnalytics\Model\Data\Event"/>
</config>
