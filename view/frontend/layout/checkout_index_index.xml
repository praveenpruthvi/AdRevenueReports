<?xml version="1.0"?>
<!--
    P2-T3 — loads the LUMA checkout-step adapter, and ONLY here.

    Scoping this to the checkout_index_index handle is what keeps CLAUDE.md #4
    intact: the RequireJS/Knockout dependency exists on the default LUMA
    checkout page and nowhere else. Every other storefront page still gets
    only the vanilla beacon, so a Hyva storefront (which does not use this
    handle) never loads any of it.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="aavirbhava-adsanalytics-checkout" xsi:type="array">
                                    <item name="component" xsi:type="string">Aavirbhava_AdsAnalytics/js/checkout-luma</item>
                                    <item name="sortOrder" xsi:type="string">0</item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
