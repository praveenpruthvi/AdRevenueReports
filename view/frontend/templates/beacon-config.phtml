<?php
/**
 * Emits the beacon's configuration and loads the beacon (P1-T7).
 *
 * THERE IS NO INLINE SCRIPT HERE, DELIBERATELY. This previously rendered
 *
 *     <script>window.aavirbhavaAdsAnalytics = {...};</script>
 *
 * which Magento's Content Security Policy BLOCKS on the checkout page:
 * "Executing inline script violates the following Content Security Policy
 * directive 'script-src ...' ... The action has been blocked."
 *
 * The consequence was silent and very misleading: the config global never
 * existed on checkout, so the beacon bailed out at its first guard and every
 * checkout event vanished — while product pages (where CSP is report-only)
 * worked perfectly. Two earlier attempts to hook LUMA's step navigator, as a
 * jsLayout component and then as a RequireJS mixin, were almost certainly
 * fine; they simply had no beacon to call.
 *
 * The config now travels as a data attribute and is read by the EXTERNAL
 * beacon file, which CSP permits because it is a same-origin script resource
 * rather than inline code. This works under both report-only and restrict
 * mode, and needs no CSP whitelist entry or inline-script hash — a hash would
 * have to be regenerated every time the config changed.
 *
 * @var \Aavirbhava\AdsAnalytics\Block\Frontend\BeaconConfig $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div id="aavirbhava-adsanalytics-config"
     data-config="<?= $escaper->escapeHtmlAttr($block->getBeaconConfigJson()) ?>"
     style="display:none"></div>
<script defer src="<?= $escaper->escapeUrl($block->getViewFileUrl('Aavirbhava_AdsAnalytics::js/ads-analytics-beacon.js')) ?>"></script>
