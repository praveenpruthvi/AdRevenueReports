<?xml version="1.0"?>
<!--
    P3-T3/P3-T4. Layout handle for Controller\Adminhtml\Report\Index.
    Without this file the controller returned a page with a title and nothing
    else — which is what the blank admin page was.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="styles"/>
    <body>
        <referenceContainer name="content">
            <block class="Aavirbhava\AdsAnalytics\Block\Adminhtml\Dashboard"
                   name="aavirbhava_adsanalytics_dashboard"
                   template="Aavirbhava_AdsAnalytics::dashboard/overview.phtml"/>
        </referenceContainer>
    </body>
</page>
