<?php
/**
 * P3-T4 — funnel drop-off and traffic-type breakdown, rendered above the
 * report grid and bound to that grid's data provider.
 *
 * text/x-magento-init rather than an inline <script>: its type is not
 * executable JavaScript, so it is not what Magento's CSP blocks. (The
 * storefront hit exactly that wall — see CLAUDE.md #4.)
 *
 * @var \Aavirbhava\AdsAnalytics\Block\Adminhtml\Dashboard $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div class="admin__fieldset-wrapper aavirbhava-ads-charts">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $escaper->escapeHtml(__('Funnel &amp; Traffic Breakdown')) ?></strong>
    </div>
    <div class="admin__fieldset-wrapper-content aavirbhava-ads-charts__content">
        <div class="aavirbhava-ads-charts__panel">
            <p class="aavirbhava-ads-charts__title"><?= $escaper->escapeHtml(__('Funnel drop-off')) ?></p>
            <canvas id="aavirbhava-ads-funnel-canvas"></canvas>
        </div>
        <div class="aavirbhava-ads-charts__panel">
            <p class="aavirbhava-ads-charts__title"><?= $escaper->escapeHtml(__('Visits by traffic type')) ?></p>
            <canvas id="aavirbhava-ads-traffic-canvas"></canvas>
        </div>
        <p class="aavirbhava-ads-charts__empty" style="display:none;">
            <?= $escaper->escapeHtml(__('No aggregated data for the current filters. The nightly rollup builds this table; run bin/magento aavirbhava:adsanalytics:aggregate to populate it now.')) ?>
        </p>
        <p class="aavirbhava-ads-charts__note">
            <?= $escaper->escapeHtml(__('Charts reflect the rows currently shown by the grid below, including its filters and page size.')) ?>
        </p>
        <!--
            P4-T2: a plain link, not a JS-driven form. It cannot read the
            grid's live filter state without duplicating that state here, so
            it deliberately reports the WHOLE dataset rather than risk
            disagreeing with what the grid/charts above show for their
            filtered view. Pass ?from=&to= (Y-m-d) by hand for a specific
            range — see Controller\Adminhtml\Report\Pdf.
        -->
        <a class="action-secondary aavirbhava-ads-charts__pdf-link"
           href="<?= $escaper->escapeUrl($block->getPdfReportUrl()) ?>">
            <?= $escaper->escapeHtml(__('Download PDF Report (full history)')) ?>
        </a>
    </div>
</div>
<?php
/**
 * P4-T5. Rendered server-side from Model\Roas\RoasReportBuilder, not bound to
 * the grid's data provider like the charts above: spend comes from a provider,
 * not from the summary table.
 */
$roas = $block->getRoasReport();
$formatMoney = static fn (float $amount): string => number_format($amount, 2);
?>
<div class="admin__fieldset-wrapper aavirbhava-ads-roas">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $escaper->escapeHtml(__('Return on Ad Spend (paid traffic)')) ?></strong>
    </div>
    <div class="admin__fieldset-wrapper-content">
        <?php if (empty($roas['rows'])): ?>
            <p class="aavirbhava-ads-charts__note">
                <?= $escaper->escapeHtml(__('No paid traffic or ad-spend data yet.')) ?>
            </p>
        <?php else: ?>
            <div class="admin__table-wrapper">
                <table class="data-grid aavirbhava-ads-roas__table">
                    <thead>
                        <tr>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Platform')) ?></th>
                            <th class="data-grid-th _right"><?= $escaper->escapeHtml(__('Spend')) ?></th>
                            <th class="data-grid-th _right"><?= $escaper->escapeHtml(__('Revenue')) ?></th>
                            <th class="data-grid-th _right"><?= $escaper->escapeHtml(__('ROAS')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($roas['rows'] as $row): ?>
                            <tr>
                                <td><?= $escaper->escapeHtml($row['label']) ?></td>
                                <td class="_right">
                                    <?= $row['spend'] === null
                                        ? $escaper->escapeHtml(__('no data'))
                                        : $escaper->escapeHtml($formatMoney($row['spend'])) ?>
                                </td>
                                <td class="_right"><?= $escaper->escapeHtml($formatMoney($row['revenue'])) ?></td>
                                <td class="_right">
                                    <?php if ($row['status'] === 'ok'): ?>
                                        <?= $escaper->escapeHtml($formatMoney($row['roas']) . 'x') ?>
                                    <?php elseif ($row['status'] === 'zero_spend'): ?>
                                        <?= $escaper->escapeHtml(__('n/a (no spend)')) ?>
                                    <?php else: ?>
                                        <?= $escaper->escapeHtml(__('no data')) ?>
                                    <?php endif; ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong><?= $escaper->escapeHtml(__('Blended (platforms with spend data)')) ?></strong></td>
                            <td class="_right"><strong><?= $escaper->escapeHtml($formatMoney($roas['totals']['spend'])) ?></strong></td>
                            <td class="_right"><strong><?= $escaper->escapeHtml($formatMoney($roas['totals']['revenue'])) ?></strong></td>
                            <td class="_right">
                                <strong>
                                    <?= $roas['totals']['roas'] === null
                                        ? $escaper->escapeHtml(__('n/a'))
                                        : $escaper->escapeHtml($formatMoney($roas['totals']['roas']) . 'x') ?>
                                </strong>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="aavirbhava-ads-charts__note">
                <?= $escaper->escapeHtml(
                    __(
                        'Period: %1 to %2. ROAS is revenue divided by spend, per platform. "no data" means no spend has been recorded for that platform, which is not the same as zero. Platforms without spend data (%3) are excluded from the blended total, since counting their revenue against only part of the cost would overstate it. Revenue and spend are only comparable on a single-currency store.',
                        $roas['from'],
                        $roas['to'],
                        $roas['totals']['rows_without_spend']
                    )
                ) ?>
            </p>
        <?php endif; ?>
    </div>
</div>
<script type="text/x-magento-init">
{
    "#aavirbhava-ads-funnel-canvas": {
        "Aavirbhava_AdsAnalytics/js/ads-dashboard-chart": {
            "listingProvider": "<?= $escaper->escapeJs($block->getListingProviderName()) ?>",
            "funnelCanvas": "aavirbhava-ads-funnel-canvas",
            "trafficCanvas": "aavirbhava-ads-traffic-canvas"
        }
    }
}
</script>
