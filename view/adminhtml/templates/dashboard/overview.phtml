<?php
/**
 * P4-T5. Rendered server-side from Model\Roas\RoasReportBuilder, not bound to
 * the grid's data provider like the charts above: spend comes from a provider,
 * not from the summary table.
 */
$roas = $block->getRoasReport();
$formatMoney = static fn (float $amount): string => number_format($amount, 2);
?>
<div class="admin__fieldset-wrapper aavirbhava-ads-roas">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $escaper->escapeHtml(__('Return on Ad Spend (paid traffic)')) ?></strong>
    </div>
    <div class="admin__fieldset-wrapper-content">
        <?php if (empty($roas['rows'])): ?>
            <p class="aavirbhava-ads-charts__note">
                <?= $escaper->escapeHtml(__('No paid traffic or ad-spend data yet.')) ?>
            </p>
        <?php else: ?>
            <div class="admin__table-wrapper">
                <table class="data-grid aavirbhava-ads-roas__table">
                    <thead>
                        <tr>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Platform')) ?></th>
                            <th class="data-grid-th _right"><?= $escaper->escapeHtml(__('Spend')) ?></th>
                            <th class="data-grid-th _right"><?= $escaper->escapeHtml(__('Revenue')) ?></th>
                            <th class="data-grid-th _right"><?= $escaper->escapeHtml(__('ROAS')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($roas['rows'] as $row): ?>
                            <tr>
                                <td><?= $escaper->escapeHtml($row['label']) ?></td>
                                <td class="_right">
                                    <?= $row['spend'] === null
                                        ? $escaper->escapeHtml(__('no data'))
                                        : $escaper->escapeHtml($formatMoney($row['spend'])) ?>
                                </td>
                                <td class="_right"><?= $escaper->escapeHtml($formatMoney($row['revenue'])) ?></td>
                                <td class="_right">
                                    <?php if ($row['status'] === 'ok'): ?>
                                        <?= $escaper->escapeHtml($formatMoney($row['roas']) . 'x') ?>
                                    <?php elseif ($row['status'] === 'zero_spend'): ?>
                                        <?= $escaper->escapeHtml(__('n/a (no spend)')) ?>
                                    <?php else: ?>
                                        <?= $escaper->escapeHtml(__('no data')) ?>
                                    <?php endif; ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong><?= $escaper->escapeHtml(__('Blended (platforms with spend data)')) ?></strong></td>
                            <td class="_right"><strong><?= $escaper->escapeHtml($formatMoney($roas['totals']['spend'])) ?></strong></td>
                            <td class="_right"><strong><?= $escaper->escapeHtml($formatMoney($roas['totals']['revenue'])) ?></strong></td>
                            <td class="_right">
                                <strong>
                                    <?= $roas['totals']['roas'] === null
                                        ? $escaper->escapeHtml(__('n/a'))
                                        : $escaper->escapeHtml($formatMoney($roas['totals']['roas']) . 'x') ?>
                                </strong>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="aavirbhava-ads-charts__note">
                <?= $escaper->escapeHtml(
                    __(
                        'Period: %1 to %2. ROAS is revenue divided by spend, per platform. "no data" means no spend has been recorded for that platform, which is not the same as zero. Platforms without spend data (%3) are excluded from the blended total, since counting their revenue against only part of the cost would overstate it. Revenue and spend are only comparable on a single-currency store.',
                        $roas['from'],
                        $roas['to'],
                        $roas['totals']['rows_without_spend']
                    )
                ) ?>
            </p>
        <?php endif; ?>
    </div>
</div>
<?php if ($block->canManageAdSpendData()): ?>
<?php
/**
 * Upload option for the ad-spend CSV, added after shipping the file-drop-only
 * version: not every admin has access to the server's filesystem to place a
 * file at var/aavirbhava/adsanalytics/adspend/<platform>.csv by hand.
 *
 * One form per platform (each with its own hidden platform_code and file
 * input) rather than one shared dropdown-plus-file-picker: a merchant
 * uploads one platform's export at a time, and a row-per-platform layout
 * keeps "which platform is this file for" unambiguous without JavaScript.
 *
 * Only shown to an admin who holds Aavirbhava_AdsAnalytics::config — see
 * Block\Adminhtml\Dashboard::canManageAdSpendData() — since that is the same
 * permission Controller\Adminhtml\AdSpend\Upload requires; nobody sees a
 * form they are not allowed to submit.
 */
$platforms = $block->getAdSpendPlatforms();
?>
<div class="admin__fieldset-wrapper aavirbhava-ads-spend-upload">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $escaper->escapeHtml(__('Ad Spend Data')) ?></strong>
    </div>
    <div class="admin__fieldset-wrapper-content">
        <?php if (empty($platforms)): ?>
            <p class="aavirbhava-ads-charts__note">
                <?= $escaper->escapeHtml(__('No ad-spend platforms are set up yet.')) ?>
            </p>
        <?php else: ?>
            <p class="aavirbhava-ads-charts__note">
                <?= $escaper->escapeHtml(__(
                    'Upload a CSV file for each platform to feed the ROAS report above. The file needs a '
                    . 'header row, then one row per day per campaign: date,campaign,spend — for example '
                    . '2026-09-19,spring_sale,42.50. Uploading a new file replaces the previous one for that '
                    . 'platform.'
                )) ?>
            </p>
            <div class="admin__table-wrapper">
                <table class="data-grid aavirbhava-ads-spend-upload__table">
                    <thead>
                        <tr>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Platform')) ?></th>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Current Data')) ?></th>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Upload New File')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($platforms as $platform): ?>
                            <tr>
                                <td><?= $escaper->escapeHtml($platform['label']) ?></td>
                                <td>
                                    <?php if ($platform['exists']): ?>
                                        <?= $escaper->escapeHtml(
                                            __(
                                                '%1 rows, updated %2',
                                                $platform['validRows'],
                                                $platform['modifiedAt']
                                            )
                                        ) ?>
                                        <?php if ($platform['skippedRows'] > 0): ?>
                                            <br>
                                            <span class="aavirbhava-ads-spend-upload__warning">
                                                <?= $escaper->escapeHtml(
                                                    __('%1 rows in this file could not be read', $platform['skippedRows'])
                                                ) ?>
                                            </span>
                                        <?php endif; ?>
                                    <?php else: ?>
                                        <?= $escaper->escapeHtml(__('No file uploaded yet')) ?>
                                    <?php endif; ?>
                                </td>
                                <td>
                                    <form method="post"
                                          enctype="multipart/form-data"
                                          action="<?= $escaper->escapeUrl($block->getAdSpendUploadUrl()) ?>"
                                          class="aavirbhava-ads-spend-upload__form">
                                        <input name="form_key" type="hidden" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>">
                                        <input name="platform_code" type="hidden" value="<?= $escaper->escapeHtmlAttr($platform['code']) ?>">
                                        <input name="ad_spend_csv" type="file" accept=".csv,text/csv" required>
                                        <button type="submit" class="action-secondary">
                                            <span><?= $escaper->escapeHtml(__('Upload')) ?></span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    </div>
</div>
<?php endif; ?>
