<?php
/**
 * P3-T4 groundwork. All output escaped via $escaper — the source/medium/
 * campaign values shown here are attacker-controllable (docs/SECURITY.md §2).
 *
 * @var \Aavirbhava\AdsAnalytics\Block\Adminhtml\Dashboard $block
 * @var \Magento\Framework\Escaper $escaper
 */
$rows = $block->getTrafficTypeBreakdown();
?>
<div class="aavirbhava-adsanalytics-dashboard">
    <?php if (!$rows): ?>
        <div class="message message-notice">
            <span>
                <strong><?= $escaper->escapeHtml(__('No aggregated data yet.')) ?></strong><br/>
                <?= $escaper->escapeHtml(__(
                    'This report reads from ads_analytics_daily_summary, which is built by the '
                    . 'nightly aggregation cron. Until that cron has run at least once, there is '
                    . 'nothing to show here — even if visits are already being captured.'
                )) ?>
            </span>
        </div>
        <div class="message message-warning">
            <span>
                <?= $escaper->escapeHtml(__(
                    'Pipeline status: the ingest endpoint and queue publisher are live, but the '
                    . 'queue consumer (P1-T6) and the aggregation cron (P3-T2) are not implemented '
                    . 'yet, so captured events are still sitting on the queue and no summary rows '
                    . 'exist. This page is wired correctly and will populate once those land.'
                )) ?>
            </span>
        </div>
    <?php else: ?>
        <div class="admin__table-wrapper">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Traffic Type')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Visits')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Add to Carts')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Checkout Starts')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Orders')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Conversion Rate')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Revenue')) ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($rows as $row): ?>
                    <tr>
                        <td><?= $escaper->escapeHtml($row['traffic_type']) ?></td>
                        <td><?= $escaper->escapeHtml((string)$row['visits']) ?></td>
                        <td><?= $escaper->escapeHtml((string)$row['add_to_carts']) ?></td>
                        <td><?= $escaper->escapeHtml((string)$row['checkout_starts']) ?></td>
                        <td><?= $escaper->escapeHtml((string)$row['orders']) ?></td>
                        <td><?= $escaper->escapeHtml($block->getConversionRate($row)) ?></td>
                        <td><?= $escaper->escapeHtml($block->formatRevenue($row)) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
