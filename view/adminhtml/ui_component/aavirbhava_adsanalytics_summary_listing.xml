<?xml version="1.0"?>
<!--
    P3-T5 — the Ads Analytics report grid.

    Reads ads_analytics_daily_summary only (CLAUDE.md #6). The dashboard chart
    above it is bound to THIS listing's data provider, so a filter applied
    here also reshapes the chart — there is deliberately no second data fetch
    that could disagree with the table.
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">aavirbhava_adsanalytics_summary_listing.aavirbhava_adsanalytics_summary_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>aavirbhava_adsanalytics_summary_columns</spinner>
        <deps>
            <dep>aavirbhava_adsanalytics_summary_listing.aavirbhava_adsanalytics_summary_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="aavirbhava_adsanalytics_summary_listing_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">summary_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Aavirbhava_AdsAnalytics::dashboard</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="aavirbhava_adsanalytics_summary_listing_data_source">
            <settings>
                <requestFieldName>summary_id</requestFieldName>
                <primaryFieldName>summary_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
        </filters>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="aavirbhava_adsanalytics_summary_columns">
        <column name="date" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="10">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Date</label>
                <timezone>false</timezone>
            </settings>
        </column>

        <column name="traffic_type" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <filter>select</filter>
                <options class="Aavirbhava\AdsAnalytics\Model\Config\Source\TrafficType"/>
                <dataType>select</dataType>
                <label translate="true">Traffic Type</label>
            </settings>
        </column>

        <column name="platform_code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Platform</label>
            </settings>
        </column>

        <column name="source" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Source</label>
            </settings>
        </column>

        <column name="medium" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Medium</label>
            </settings>
        </column>

        <column name="campaign" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Campaign</label>
            </settings>
        </column>

        <column name="visits" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Visits</label>
            </settings>
        </column>

        <column name="add_to_carts" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Add to Carts</label>
            </settings>
        </column>

        <column name="checkout_starts" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Checkout Starts</label>
            </settings>
        </column>

        <column name="orders" sortOrder="100">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Orders</label>
            </settings>
        </column>

        <column name="revenue" class="Magento\Ui\Component\Listing\Columns\Column" sortOrder="110">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Revenue</label>
            </settings>
        </column>

        <!--
            Derived in SQL by the grid collection, so they sort and filter
            like stored columns. Computing them in PHP would only ever cover
            the current page.
        -->
        <column name="cart_rate" sortOrder="120">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Cart Rate %</label>
                <visible>false</visible>
            </settings>
        </column>

        <column name="conversion_rate" sortOrder="130">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Conversion Rate %</label>
            </settings>
        </column>

        <column name="revenue_per_visit" sortOrder="140">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Revenue / Visit</label>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
